{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.8",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "icons": {
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "identity",
    "search"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://www.google.com/*",
    "https://api.bing.com/*",
    "https://suggestion.baidu.com/*"
  ],
  "oauth2": {
    "_comment_client_id": "Google OAuth2 客户端 ID，用于身份验证和 Google Drive API 访问。需要在 Google Cloud Console 创建 OAuth2 客户端凭据，并配置授权重定向 URI 为 chrome-extension://[扩展ID] / Google OAuth2 Client ID for authentication and Google Drive API access. Create OAuth2 client credentials in Google Cloud Console and configure the authorized redirect URI as chrome-extension://[extension-id]",
    "client_id": "",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}